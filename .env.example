NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# matsunoya-dine の /api/pos/* を呼ぶ先。未設定時は https://app.matsunoyafoods.com を使う。
NEXT_PUBLIC_MATSUNOYA_DINE_API_URL=https://app.matsunoyafoods.com
# スタッフログイン導線 (Telegram bot-login) のURL。未設定時は上と同じドメインの /admin-login を使う。
NEXT_PUBLIC_MATSUNOYA_DINE_ADMIN_LOGIN_URL=https://app.matsunoyafoods.com/admin-login

# --- POS ネイティブ (PIN ログイン) 用。単体運用モードで使う (multi-tenant-productization-spec.md) ---
# service_role キー。matsunoya-dine と同じ Supabase プロジェクトのものを使う。
SUPABASE_SERVICE_ROLE_KEY=
# このデプロイが担当する pos.stores.id。Phase B 時点では 1 デプロイ = 1 店舗の前提。
POS_STORE_ID=
# PIN ログインのセッション JWT 署名用シークレット (32文字以上のランダム文字列を推奨)。
POS_STAFF_SESSION_SECRET=
